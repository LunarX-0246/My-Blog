# ═══════════════════════════════════════════════════════════════
#  环境变量模板
#
#  用法：复制为 .env 后填入真实值。
#  ⚠️ .env 已在 .gitignore 中，绝对不要提交。
#
#  本文件同时是**配置契约**：后端 app/config.py 应严格按以下键名读取，
#  不要在代码里另起名字，也不要把可调参数写死在代码中。
# ═══════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────
#  数据库
# ───────────────────────────────────────────────
# ⚠️ 本机开发端口是 5433，不是 5432。
#    5432 被本机原生 PostgreSQL 18 占用且仍在使用（见 环境说明.md §2）。
#    容器内部与生产环境仍为 5432。
DATABASE_URL=postgresql+psycopg://blog:dev@127.0.0.1:5433/blog

# 供 docker-compose 创建数据库使用
POSTGRES_DB=blog
POSTGRES_USER=blog
POSTGRES_PASSWORD=dev


# ───────────────────────────────────────────────
#  认证（单一博主账号，系统内不提供注册）
# ───────────────────────────────────────────────
ADMIN_USERNAME=
# 密码以哈希形式存放，不存明文。生成方式见 README。
ADMIN_PASSWORD_HASH=
# 用于签名会话 Cookie。随机长字符串，切勿使用示例值。
SESSION_SECRET=
# 登录有效期（秒），默认 7 天
SESSION_MAX_AGE=604800
# 登录失败锁定：次数与锁定时长（秒）
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900


# ───────────────────────────────────────────────
#  大语言模型（DeepSeek）
# ───────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 主模型调用失败时的降级目标，留空则不降级
LLM_FALLBACK_MODEL=


# ───────────────────────────────────────────────
#  文本向量化（千问 text-embedding）
# ───────────────────────────────────────────────
DASHSCOPE_API_KEY=
# ⚠️ 若使用的是阿里云**专属业务空间（workspace）**的 Key，
#    base_url 不是下面这个公网地址，而是形如
#    https://ws-xxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#    请以控制台导出的实际地址为准，照抄公网地址会连不上。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
# ⚠️ 维度必须与建索引时一致。启动自检会校验此值（FR-IDX-10）。
EMBEDDING_DIM=1024


# ───────────────────────────────────────────────
#  向量存储后端
# ───────────────────────────────────────────────
# pgvector = 生产使用；numpy = 对比实验使用（技术方案 §12）
VECTOR_BACKEND=pgvector


# ───────────────────────────────────────────────
#  RAG 参数
# ───────────────────────────────────────────────
# 单块最大字符数，超出则按段落二次切分
CHUNK_MAX_CHARS=800
# 向量化批量大小
EMBED_BATCH_SIZE=20
# 每路检索的召回数量
RETRIEVE_TOP_K=10
# 最终送入 Prompt 的块数
CONTEXT_TOP_K=5
# RRF 融合常数
RRF_K=60
# 多轮对话中完整保留的最近轮数，更早的仅保留问题与结论
MEMORY_KEEP_FULL_TURNS=2


# ───────────────────────────────────────────────
#  限流与成本控制（FR-ASK-19 ~ 22）
# ───────────────────────────────────────────────
ASK_RATE_LIMIT_PER_HOUR=10
ASK_MAX_QUESTION_CHARS=1000
# 全站每日调用总量上限，超出后问答降级为不可用
ASK_DAILY_TOTAL_LIMIT=200


# ───────────────────────────────────────────────
#  文件存储
# ───────────────────────────────────────────────
# 运行时数据根目录，其下含 uploads/ images/ vectors/
# 该目录已在 .gitignore 中，应用启动时自行创建
DATA_DIR=./data
UPLOAD_MAX_MB=50


# ───────────────────────────────────────────────
#  服务地址
# ───────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
# 供 Next.js 服务端渲染时调用后端使用。
# 本机开发：http://127.0.0.1:8000
# 容器内：  http://api:8000
INTERNAL_API_BASE=http://127.0.0.1:8000
