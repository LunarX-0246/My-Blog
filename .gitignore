# ─────────────────────────────────────────────
#  密钥与环境变量 —— 绝对不能进仓库
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem

# ─────────────────────────────────────────────
#  运行时数据（上传的文件、配图、向量产物、数据库）
#  这些是生成物，且可能含个人内容，一律不进版本控制
# ─────────────────────────────────────────────
backend/data/
pgdata/
*.db
*.sqlite3
*.npy

# ─────────────────────────────────────────────
#  Python
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─────────────────────────────────────────────
#  Node / Next.js
# ─────────────────────────────────────────────
node_modules/
.next/
out/
build/
.turbo/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─────────────────────────────────────────────
#  实验产物（报告本身要进仓库，中间数据不要）
# ─────────────────────────────────────────────
backend/experiments/output/
backend/experiments/*.npy
backend/experiments/*.csv

# ─────────────────────────────────────────────
#  编辑器与 AI 工具的本地配置
#  （若希望团队/多设备共享这些配置，删掉对应行即可）
# ─────────────────────────────────────────────
.vscode/
.idea/
.claude/
.cursor/
*.swp
.DS_Store
Thumbs.db
desktop.ini
