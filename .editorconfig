# 统一编辑器行为，避免不同工具产生无意义的格式 diff
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.md]
# Markdown 中行尾双空格是换行语义，不能裁剪
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
